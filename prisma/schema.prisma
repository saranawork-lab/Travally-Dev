// Prisma Schema for Travally - Social Travel Companion & Activity Discovery Platform
// Configured for MongoDB Atlas Cloud

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  email              String    @unique
  passwordHash       String
  role               String    @default("USER") // USER, ADMIN
  activeSessionToken String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile               Profile?
  activitiesOrganized   Activity[]        @relation("OrganizedActivities")
  travelPlansOrganized  TravelPlan[]      @relation("OrganizedTravelPlans")
  joinRequestsSent      JoinRequest[]     @relation("SentRequests")
  participants          Participant[]
  messagesSent          Message[]         @relation("SentMessages")
  notifications         Notification[]    @relation("UserNotifications")
  blocksGiven           Block[]           @relation("BlocksGiven")
  blocksReceived        Block[]           @relation("BlocksReceived")
  reportsCreated        Report[]          @relation("ReportsCreated")
}

model Profile {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String    @unique @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String
  avatarUrl             String?
  bio                   String?
  birthDate             DateTime?
  age                   Int?
  gender                String?   // MALE, FEMALE, NON_BINARY, OTHER, PREFER_NOT_TO_SAY
  city                  String?
  region                String?
  address               String?
  pincode               String?
  country               String?
  interests             String    @default("[]") // JSON string array: ["Cinema", "Coffee", "Hiking"]
  preferredActivities   String    @default("[]") // JSON string array
  connectionPreferences String    @default("{}") // JSON string: { "dating": false, "friendship": true, "travel": true }
  isVerified            Boolean   @default(false)
  verificationStatus    String    @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED
  linkedinUrl           String?
  hideContactDetails    Boolean   @default(true)
  discoveryVisible      Boolean   @default(true)
  membershipStatus      String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  membershipTier        String    @default("FOUNDING_EXPLORER") // FOUNDING_EXPLORER, VOYAGER, GLOBETROTTER
  membershipNumber      String?   // e.g. "TRV-849201"
  memberSince           DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Activity {
  id                     String         @id @default(auto()) @map("_id") @db.ObjectId
  organizerId            String         @db.ObjectId
  organizer              User           @relation("OrganizedActivities", fields: [organizerId], references: [id], onDelete: Cascade)
  title                  String
  description            String
  category               String         // MOVIES, FOOD_CAFES, WALKING, STUDYING, EVENTS, SHOPPING, CITY_EXPLORATION, OTHER
  date                   DateTime
  startTime              String         // "19:00"
  approxDurationHours    Float          @default(2.0)
  locationName           String
  meetingPointVenue      String?
  maxParticipants        Int            @default(2)
  currentAcceptedCount   Int            @default(0)
  preferredAgeMin        Int?
  preferredAgeMax        Int?
  genderPreference       String         @default("ANY") // ANY, FEMALE_ONLY, MALE_ONLY
  additionalRequirements String?
  visibility             String         @default("PUBLIC") // PUBLIC, FILTERED
  cutoffHoursBeforeStart Int            @default(2)
  status                 String         @default("OPEN") // OPEN, FULL, CANCELLED, EXPIRED
  imageUrl               String?
  videoUrl               String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  requests               JoinRequest[]
  participants           Participant[]
  conversations          Conversation[]

  @@index([status])
  @@index([organizerId])
  @@index([category])
}

model TravelPlan {
  id                      String         @id @default(auto()) @map("_id") @db.ObjectId
  organizerId             String         @db.ObjectId
  organizer               User           @relation("OrganizedTravelPlans", fields: [organizerId], references: [id], onDelete: Cascade)
  destination             String
  departureCity           String
  startDate               DateTime
  endDate                 DateTime
  budgetMin               Float?
  budgetMax               Float?
  currency                String         @default("USD")
  travelStyle             String         @default("CULTURAL") // BACKPACKING, CULTURAL, SLOW_TRAVEL, ADVENTURE, LUXURY, ROAD_TRIP, RELAXATION
  interests               String         @default("[]") // JSON string: ["Photography", "Museums", "Food"]
  plannedAttractions      String?        @default("[]") // JSON string: ["Senso-ji", "Akihabara"]
  accommodationPreference String         @default("FLEXIBLE") // HOSTEL, HOTEL, AIRBNB, FLEXIBLE
  transportPreference     String         @default("FLEXIBLE") // FLIGHT, TRAIN, ROAD_TRIP, FLEXIBLE
  groupSizeMax            Int            @default(3)
  currentAcceptedCount    Int            @default(0)
  companionPreferences    String?        @default("{}") // JSON string
  status                  String         @default("OPEN") // OPEN, FULL, COMPLETED, CANCELLED
  imageUrl                String?
  videoUrl                String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  requests                JoinRequest[]
  participants            Participant[]
  conversations           Conversation[]

  @@index([status])
  @@index([organizerId])
  @@index([travelStyle])
}

model JoinRequest {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  type         String      // ACTIVITY, TRAVEL
  activityId   String?     @db.ObjectId
  activity     Activity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  travelPlanId String?     @db.ObjectId
  travelPlan   TravelPlan? @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  applicantId  String      @db.ObjectId
  applicant    User        @relation("SentRequests", fields: [applicantId], references: [id], onDelete: Cascade)
  status       String      @default("PENDING") // PENDING, ACCEPTED, DECLINED, CANCELLED, EXPIRED
  introMessage String?
  createdAt    DateTime    @default(now())
  respondedAt  DateTime?

  @@index([applicantId, activityId])
  @@index([applicantId, travelPlanId])
  @@index([status])
  @@index([activityId])
  @@index([travelPlanId])
}

model Participant {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  userId       String      @db.ObjectId
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId   String?     @db.ObjectId
  activity     Activity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  travelPlanId String?     @db.ObjectId
  travelPlan   TravelPlan? @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  role         String      @default("MEMBER") // ORGANIZER, MEMBER
  joinedAt     DateTime    @default(now())

  @@index([userId, activityId])
  @@index([userId, travelPlanId])
}

model Conversation {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  type         String      // ACTIVITY, TRAVEL
  activityId   String?     @db.ObjectId
  activity     Activity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  travelPlanId String?     @db.ObjectId
  travelPlan   TravelPlan? @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  title        String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  messages     Message[]

  @@index([activityId])
  @@index([travelPlanId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.ObjectId
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readBy         String       @default("[]") // JSON string array of user IDs
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String   // REQUEST_RECEIVED, REQUEST_ACCEPTED, REQUEST_DECLINED, NEW_MESSAGE, ACTIVITY_CANCELLED, TRIP_UPDATE
  title     String
  body      String
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Block {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  blockerId String   @db.ObjectId
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.ObjectId
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  type      String   @default("BLOCK") // BLOCK, RESTRICT
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  reporterId  String   @db.ObjectId
  reporter    User     @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String   // USER, ACTIVITY, TRAVEL
  targetId    String
  reason      String
  details     String?
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  actionTaken String?
  createdAt   DateTime @default(now())
}

model NewsletterSubscriber {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  subscribedAt DateTime  @default(now())
  isActive     Boolean   @default(true)
  metadata     String?
}
